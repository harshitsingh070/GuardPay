# Copy to .env for local runs.
# Vite only exposes VITE_-prefixed variables to the browser.
# For a phone on the same network, use the dev machine's LAN IP (for example
# http://192.168.1.20:8080) instead of localhost.
VITE_API_BASE_URL=http://localhost:8080
# Development-only device pairing token for the phone call-state demo.
# Must match GUARDPAY_DEVICE_SIGNAL_TOKEN in backend/.env. The value ships to
# the browser, so this is a demo pairing mechanism, not production security.
VITE_GUARDPAY_DEVICE_TOKEN=
