# Copy to backend/.env for local runs (never commit real secrets).
# Spring Boot auto-loads backend/.env at startup (see application.yml
# spring.config.import), so plain `mvn spring-boot:run` just works.
# Explicit OS environment variables still take precedence over this file.
# Matches docker-compose.yml service `db` defaults.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardpay
DB_USERNAME=guardpay
DB_PASSWORD=guardpay
# Browser/WebView origins allowed to call the API (comma-separated).
# appassets.androidplatform.net is the bundled Android app's WebView origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://appassets.androidplatform.net
# Cookie-backed authentication. Keep enabled in normal runs; tests set
# guardpay.auth.enabled=false through src/test/resources/application.yml.
GUARDPAY_AUTH_ENABLED=true
# Set true behind HTTPS so the session cookie is only sent over TLS.
GUARDPAY_AUTH_COOKIE_SECURE=false
# Session cookie SameSite policy and optional HTTPS-only request enforcement.
GUARDPAY_AUTH_COOKIE_SAME_SITE=Lax
GUARDPAY_AUTH_REQUIRE_HTTPS=false
# CSRF protection for cookie-authenticated unsafe requests. The browser fetches
# GET /api/auth/csrf and echoes the token in X-CSRF-Token. Set a stable secret
# only if you need stateless token validation across restarts.
GUARDPAY_AUTH_CSRF_ENABLED=true
GUARDPAY_AUTH_CSRF_SECRET=
# Login brute-force limits (per email+IP and per IP).
GUARDPAY_AUTH_LOGIN_MAX_ATTEMPTS=5
GUARDPAY_AUTH_LOGIN_IP_MAX_ATTEMPTS=20
GUARDPAY_AUTH_LOGIN_WINDOW_MINUTES=15
GUARDPAY_AUTH_LOGIN_LOCKOUT_MINUTES=15
# PayPal Sandbox (Milestone 7). NEVER commit real credentials.
# The backend boots without these; /api/paypal/health reports DOWN until set.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal Developer Dashboard (Sandbox app → Webhooks → show).
# Required for signature verification; NEVER commit the real value, never log it.
PAYPAL_WEBHOOK_ID=
# Device call-state credentials are issued per device through the authenticated
# /api/devices endpoints; the Android shell stores its token locally and sends
# it as X-GuardPay-Device-Token. There is no shared device-token setting.
# Controlled VERIFY challenge (demo). Codes are delivered to a server-side
# outbox and can only be read from loopback; they are never returned to the
# browser or written to logs. Set to false in production or with a real channel.
GUARDPAY_DEV_VERIFICATION_OUTBOX=true
GUARDPAY_VERIFICATION_TTL_MINUTES=10
GUARDPAY_VERIFICATION_MAX_ATTEMPTS=3
# Python AI evidence service (optional). The backend works without it.
AI_SERVICE_BASE_URL=http://localhost:8001
# AI_SERVICE_ENABLED=false
# Groq-backed analysis runs two agents; give the internal hop headroom.
# AI_SERVICE_READ_TIMEOUT_MS=15000
# Shared Spring Boot -> AI service secret. Set the SAME value in the Python
# service environment; it is sent as X-GuardPay-Internal-Token.
AI_SERVICE_INTERNAL_TOKEN=
# Comma-separated user emails promoted to admin on startup. Admins can open the
# feedback review and continuous-learning consoles. Server-side only; clients
# cannot grant themselves admin. Example:
# GUARDPAY_INTELLIGENCE_ADMIN_EMAILS=you@example.com
GUARDPAY_INTELLIGENCE_ADMIN_EMAILS=
