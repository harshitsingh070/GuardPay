# Copy to .env for local runs (never commit real secrets).
# Groq is the default LLM provider and exposes an OpenAI-compatible API.
# Get a key at https://console.groq.com/keys (starts with gsk_).
# Without a key the service still boots and returns local URL findings only.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Alternative Groq models: llama-3.3-70b-versatile, openai/gpt-oss-120b
# To use OpenAI instead:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Reserved for supervisors that read app settings; the documented uvicorn
# command sets the port with --port 8001.
AI_SERVICE_PORT=8001
