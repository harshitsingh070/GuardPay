# Copy to .env for local runs (never commit real secrets).
# The service boots without a key; /api/v1/analyze then fails clearly (503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only needed for OpenAI-compatible gateways (e.g. OpenRouter):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_SERVICE_PORT=8001
